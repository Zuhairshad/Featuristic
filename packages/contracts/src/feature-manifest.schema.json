{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featurekit.dev/schemas/feature-manifest-0.1.json",
  "title": "FeatureKit feature manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "displayName", "maturity", "requires", "effects"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "maturity": { "enum": ["experimental", "supported"] },
    "requires": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "effects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
