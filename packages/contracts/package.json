{
  "name": "@featurekit/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./feature-manifest.schema.json": "./dist/feature-manifest.schema.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && cp src/feature-manifest.schema.json dist/feature-manifest.schema.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
