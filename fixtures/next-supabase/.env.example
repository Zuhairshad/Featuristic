# Copy to .env.local and fill from the LOCAL stack: pnpm supabase:start, then `pnpm exec supabase status -o env`.
# Never put hosted-project values here. .env.local is git-ignored.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from supabase status>
# Server-only (no NEXT_PUBLIC_ prefix): used by the background worker.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from supabase status>
# Shared secret for POST /api/internal/import-worker. Leave unset to disable the endpoint.
IMPORT_WORKER_SECRET=<any long random local value>
# Shows "Run worker once" on the import page. Only honored when the Supabase URL is loopback.
IMPORT_CENTER_DEV_CONTROLS=true
