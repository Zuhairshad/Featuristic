{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "apps/**/*.ts",
      "packages/**/*.ts",
      "fixtures/**/*.ts",
      "fixtures/**/*.tsx",
      "!!fixtures/next-supabase/.next"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
